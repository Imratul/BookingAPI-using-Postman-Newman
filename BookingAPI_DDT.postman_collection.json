		{
			"name": "CreateBookingID",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var firstName=pm.iterationData.get('firstname')\r",
							"pm.environment.set('first_Name',firstName)\r",
							"\r",
							"var lastName=pm.iterationData.get('lastname')\r",
							"pm.environment.set('last_Name',lastName)\r",
							"\r",
							"var totalPrice=pm.iterationData.get('totalprice')\r",
							"pm.environment.set('total_Price',totalPrice)\r",
							"\r",
							"var depositPaid=pm.iterationData.get('depositpaid')\r",
							"pm.environment.set('deposit_paid',depositPaid)\r",
							"\r",
							"var checkIn=pm.iterationData.get('checkin')\r",
							"pm.environment.set('check_in',checkIn)\r",
							"\r",
							"var checkOut=pm.iterationData.get('checkout')\r",
							"pm.environment.set('check_out',checkOut)\r",
							"\r",
							"var additionalNeeds=pm.iterationData.get('additionalneeds')\r",
							"pm.environment.set('additional_needs',additionalNeeds)"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var JsonData = pm.response.json();\r",
							"console.log(JsonData);\r",
							"\r",
							"pm.environment.set(\"id\", JsonData.bookingid);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"firstname\": \"{{first_Name}}\",\r\n    \"lastname\": \"{{last_Name}}\",\r\n    \"totalprice\": {{total_Price}},\r\n    \"depositpaid\": {{deposit_paid}},\r\n    \"bookingdates\": {\r\n        \"checkin\": \"{{check_in}}\",\r\n        \"checkout\": \"{{check_out}}\"\r\n    },\r\n    \"additionalneeds\": \"{{additional_needs}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/booking",
					"host": [
						"{{url}}"
					],
					"path": [
						"booking"
					]
				}
			},
			"response": []
		},
