		{
			"name": "CreateBookingID",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"\r",
							"//FirstName\r",
							"var firstName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r",
							"pm.environment.set(\"firstName\",firstName);\r",
							"\r",
							"\r",
							"//LastName\r",
							"var lastName = pm.variables.replaceIn(\"{{$randomLastName}}\");\r",
							"pm.environment.set(\"lastName\",lastName);\r",
							"\r",
							"//TotalPrice\r",
							"var totalPrice = pm.variables.replaceIn(\"{{$randomInt}}\");\r",
							"pm.environment.set(\"totalPrice\", totalPrice);\r",
							"\r",
							"//DepositPrice\r",
							"var depositPaid= pm.variables.replaceIn(\"{{$randomBoolean}}\");\r",
							"pm.environment.set(\"depositPaid\", depositPaid);\r",
							"\r",
							"// var checkin = pm.variables.replaceIn(\"{{$randomDateFuture}}\");\r",
							"// console.log(checkin);\r",
							"\r",
							"//Check in Date\r",
							"const today = require('moment');\r",
							"const checkin = today();\r",
							"var checkinDate =  checkin.format(\"YYYY-MM-DD\");\r",
							"pm.environment.set(\"checkinDate\",checkinDate);\r",
							"\r",
							"//Check out date\r",
							"var checkoutDate = checkin.add(5,'d').format(\"YYYY-MM-DD\");\r",
							"pm.environment.set(\"checkoutDate\",checkoutDate);\r",
							"\r",
							"//additional\r",
							"const need = ['Breakfast', 'Mid Breakfast','Lunch', 'Mid Lunch', 'Evening Snacks', 'Dinner' ];\r",
							"const additional = need [Math.floor(Math.random()*need.length)];\r",
							"// var additional = pm.variables.replaceIn(\"{{$randomCity}}\");\r",
							"pm.environment.set(\"additional\", additional);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var status_code = pm.response.code;\r",
							"console.log(status_code);\r",
							"if(status_code == 200){\r",
							"//This is testing Assertions\r",
							"var JsonData = pm.response.json();\r",
							"\r",
							"    pm.environment.set(\"id\", JsonData.bookingid);\r",
							"pm.test(\"First Name Validation\", function () {\r",
							"    pm.expect(JsonData.booking.firstname).to.eql(pm.environment\r",
							"        .get(\"firstName\"))\r",
							"})\r",
							"pm.test(\"Last Name Validation\", function () {\r",
							"    pm.expect(JsonData.booking.lastname).to.eql(pm.environment.get(\"lastName\"))\r",
							"})\r",
							"pm.test(\"Total Price Validation\", function () {\r",
							"    pm.expect(JsonData.booking.totalprice.toString()).to.eql(pm.environment.get(\"totalPrice\"))\r",
							"})\r",
							"pm.test(\"Deposit Paid Validation\", function () {\r",
							"    pm.expect(JsonData.booking.depositpaid.toString()).to.eql(pm.environment.get(\"depositPaid\"))\r",
							"})\r",
							"pm.test(\"Checkin Date Validation\", function () {\r",
							"    pm.expect(JsonData.booking.bookingdates.checkin).to.eql(pm.environment.get(\"checkinDate\"))\r",
							"})\r",
							"pm.test(\"Checkout Date Validation\", function () {\r",
							"    pm.expect(JsonData.booking.bookingdates.checkout).to.eql(pm.environment.get(\"checkoutDate\"))\r",
							"})\r",
							"pm.test(\"Additional Needs Validation\", function () {\r",
							"    pm.expect(JsonData.booking.additionalneeds).to.eql(pm.environment.get(\"additional\"))\r",
							"})\r",
							"\r",
							"}\r",
							"else if(status_code == 404){\r",
							"    pm.test(\"Not Found\")\r",
							"} else{\r",
							"    pm.test(\"Something went wrong\")\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
